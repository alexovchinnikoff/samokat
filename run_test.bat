@echo off
chcp 65001 >nul
title Запуск автотестов Яндекс Самокат

echo ==========================================
echo 🚀 Запуск автотестов проекта «Яндекс Самокат»
echo ==========================================

:: 1. Активируем виртуальное окружение
echo [1/3] Активация виртуального окружения...
call .\venv\Scripts\activate.bat

if %errorlevel% neq 0 (
    echo ❌ Ошибка: Не удалось активировать venv.
    echo Проверь, лежит ли папка .venv рядом с этим файлом.
    pause
    exit /b 1
)

:: 2. Запускаем pytest
echo [2/3] Запуск тестов и сбор данных...
:: --alluredir=allure-results: сохраняем данные для отчета (даже если Allure не откроется)
:: -v: подробный вывод имен тестов
python -m pytest --alluredir=allure-results -v

:: Сохраняем код возврата (прошли тесты или нет)
set TEST_RESULT=%errorlevel%

:: 3. Итог (без попытки открыть Allure, чтобы не было ошибок)
echo [3/3] Готово!
if %TEST_RESULT% equ 0 (
    echo ==========================================
    echo 🎉 ВСЕ ТЕСТЫ ПРОЙДЕНЫ УСПЕШНО!
    echo ==========================================
) else (
    echo ==========================================
    echo ⚠️ ТЕСТЫ ЗАВЕРШЕНЫ С ОШИБКАМИ (см. консоль выше)
    echo ==========================================
)

echo.
echo 💡 Совет: Чтобы увидеть красивый отчет, открой папку allure-results
echo     или запусти команду: allure serve allure-results (если Allure установлен).
echo     Либо просто открой файл report.html (если делал --html).

pause